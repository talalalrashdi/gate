@{
    Layout = "_AdminLayout";
}
@section Styles {
  <link rel="stylesheet" href="@Url.Content("~/css/admin-media.css")" asp-append-version="true">
  <link rel="stylesheet" href="@Url.Content("~/css/admin-fixed-orders.css")" asp-append-version="true">
  <link rel="stylesheet" href="@Url.Content("~/css/admin-documents.css")" asp-append-version="true">
  <link rel="stylesheet" href="@Url.Content("~/css/admin-themes.css")" asp-append-version="true">
  <link rel="stylesheet" href="@Url.Content("~/css/admin-images.css")" asp-append-version="true">
  <link rel="stylesheet" href="@Url.Content("~/css/admin-cards.css")" asp-append-version="true">
  <link rel="stylesheet" href="@Url.Content("~/css/admin-applications.css")" asp-append-version="true">
}
<section data-admin-panel="overview" aria-label="نظرة عامة" hidden>
  <div class="admin-welcome"><div><span class="admin-eyebrow">أهلًا بك في مساحة الإدارة</span><h2>تفاصيل صغيرة،<br>تجربة أفضل للجميع.</h2><p>رتّب البطاقات الأساسية وحدّد مواضعها. أدر صور الواجهة ومجموعاتها، وحدّد صور كل ثيم.</p><button type="button" class="admin-primary" data-admin-section="cards">إدارة البطاقات <span aria-hidden="true">←</span></button></div><div class="admin-welcome-art" aria-hidden="true"><div class="admin-art-card"><span></span><i></i><i></i><i></i></div><div class="admin-art-mini"><span>✓</span><i></i><i></i></div><div class="admin-art-dot"></div></div></div>
  <div class="admin-stats"><article><span class="admin-stat-icon" aria-hidden="true">▦</span><div><strong data-admin-total>—</strong><span>بطاقات أساسية</span></div></article><article><span class="admin-stat-icon" aria-hidden="true">⌖</span><div><strong data-admin-fixed>—</strong><span>بطاقات ثابتة</span></div></article><article><span class="admin-stat-icon" aria-hidden="true">↔</span><div><strong data-admin-movable>—</strong><span>بطاقات قابلة للترتيب</span></div></article></div>
  <div class="admin-section-heading"><div><h2>أقسام الإدارة</h2><p>اختر القسم الذي تريد إدارته.</p></div><span class="admin-muted">المحتوى والمظهر</span></div>
  <div class="admin-feature-grid">
    <button type="button" class="admin-feature" data-admin-section="cards"><span class="admin-feature-top"><span class="admin-feature-icon" aria-hidden="true">▦</span><span class="admin-badge is-ready">متاح الآن</span></span><strong>البطاقات الأساسية</strong><span>أسماء البطاقات، ترتيبها الافتراضي، وتثبيتها في مواضع محددة.</span><span class="admin-feature-action">إدارة البطاقات <span aria-hidden="true">←</span></span></button>
    <button type="button" class="admin-feature" data-admin-section="images"><span class="admin-feature-top"><span class="admin-feature-icon" aria-hidden="true">▧</span><span class="admin-badge is-ready">متاح الآن</span></span><strong>صور الواجهة</strong><span>إضافة الصور وترتيبها، والتحكم بتشغيل التدوير التلقائي أو إيقافه.</span><span class="admin-feature-action">استعراض القسم <span aria-hidden="true">←</span></span></button>
    <button type="button" class="admin-feature" data-admin-section="themes"><span class="admin-feature-top"><span class="admin-feature-icon" aria-hidden="true">◐</span><span class="admin-badge is-ready">متاح الآن</span></span><strong>الثيمات والمظهر</strong><span>إضافة ثيمات وإدارة مظهر البوابة والثيم الافتراضي للمستخدمين.</span><span class="admin-feature-action">استعراض القسم <span aria-hidden="true">←</span></span></button>
  </div>
</section>
<section data-admin-panel="cards" aria-label="البطاقات الأساسية" hidden>
  <div class="admin-stats"><article><span class="admin-stat-icon" aria-hidden="true">▦</span><div><strong data-admin-total>—</strong><span>بطاقات أساسية</span></div></article><article><span class="admin-stat-icon" aria-hidden="true">⌖</span><div><strong data-admin-fixed>—</strong><span>مواضع ثابتة</span></div></article><article><span class="admin-stat-icon" aria-hidden="true">↔</span><div><strong data-admin-movable>—</strong><span>بطاقات متحركة</span></div></article></div>
  <div class="admin-panel"><div class="admin-panel-header"><div><h2>إعدادات البطاقات</h2><p>أنشئ بطاقة تطبيقات، وحدّد الجمهور والإظهار والموضع. احفظ كل بطاقة على حدة.</p></div><button type="button" id="admin-card-create" class="admin-primary" disabled>إضافة بطاقة تطبيقات +</button></div><div id="admin-cards"></div></div>
  <aside class="admin-help"><span aria-hidden="true">ⓘ</span><div><h3>البطاقات والجمهور والصلاحيات</h3><p>بطاقة التطبيقات مشتركة وليست بطاقة شخصية. إظهارها لا يمنح صلاحية للتطبيقات؛ يرى كل موظف التطبيقات المصرح بها فقط. الأدوار تأتي من قاعدة الصلاحيات الحالية.</p><p>الموضع يبدأ من 1. تُحفظ مواضع البطاقات الثابتة، وتُضغط عند غياب بطاقات مقيدة بالأدوار. يحتفظ الموظف بترتيبه للبطاقات المتحركة. قبل إخفاء بطاقة قد يلزم تقديم بطاقة ثابتة تقع خارج العدد الجديد.</p><p>الإخفاء يحتفظ بالإعدادات وترتيب الموظفين. إنشاء البطاقة لا ينشئ ربطًا جديدًا مع الأنظمة؛ البطاقات المتصلة الحالية تحتفظ بمحتواها.</p></div></aside>
</section>
@await Html.PartialAsync("_Images")
@await Html.PartialAsync("_Themes")
@await Html.PartialAsync("_Applications")
@await Html.PartialAsync("_DocumentLibrary")
@await Html.PartialAsync("_SafetyLibrary")
@await Html.PartialAsync("_FixedOrders")
@await Html.PartialAsync("_Media")
@section Scripts {
  <script src="@Url.Content("~/js/admin-media.js")" asp-append-version="true"></script>
  <script src="@Url.Content("~/js/fixed-order-text.js")" asp-append-version="true"></script>
  <script src="@Url.Content("~/js/admin-fixed-orders.js")" asp-append-version="true"></script>
  <script src="@Url.Content("~/js/admin-documents.js")" asp-append-version="true"></script>
  <script src="@Url.Content("~/js/admin-themes.js")" asp-append-version="true"></script>
  <script src="@Url.Content("~/js/admin-images.js")" asp-append-version="true"></script>
  <script src="@Url.Content("~/js/admin-cards.js")" asp-append-version="true"></script>
  <script src="@Url.Content("~/js/admin-applications.js")" asp-append-version="true"></script>
}
