@{
    Layout = "_AdminLayout";
}
@section Styles {
  <link rel="stylesheet" href="@Url.Content("~/css/admin-events.css")" asp-append-version="true">
  <link rel="stylesheet" href="@Url.Content("~/css/decision-notices.css")" asp-append-version="true">
  <link rel="stylesheet" href="@Url.Content("~/css/admin-media.css")" asp-append-version="true">
  <link rel="stylesheet" href="@Url.Content("~/css/admin-fixed-orders.css")" asp-append-version="true">
  <link rel="stylesheet" href="@Url.Content("~/css/admin-documents.css")" asp-append-version="true">
  <link rel="stylesheet" href="@Url.Content("~/css/admin-themes.css")" asp-append-version="true">
  <link rel="stylesheet" href="@Url.Content("~/css/admin-images.css")" asp-append-version="true">
  <link rel="stylesheet" href="@Url.Content("~/css/admin-cards.css")" asp-append-version="true">
  <link rel="stylesheet" href="@Url.Content("~/css/admin-applications.css")" asp-append-version="true">
  <link rel="stylesheet" href="@Url.Content("~/css/admin-header-content.css")" asp-append-version="true">
}
<section data-admin-panel="overview" aria-label="نظرة عامة" hidden>
  <div class="admin-overview-toolbar"><p id="admin-overview-status" role="status">جارٍ تحميل النظرة العامة…</p><button type="button" id="admin-overview-retry" hidden>إعادة المحاولة</button></div>
  <div id="admin-overview-cards" class="admin-overview-grid"></div>
  <div class="admin-section-heading"><div><h2>وصول سريع</h2><p>الأقسام المصرّح لك بإدارتها.</p></div></div>
  <div class="admin-feature-grid"></div>
</section>
<section data-admin-panel="cards" aria-label="البطاقات الأساسية" hidden>
  <div class="admin-stats"><article><span class="admin-stat-icon" aria-hidden="true"><i class="iconsax" icon-name="grid-apps" aria-hidden="true"></i></span><div><strong data-admin-total>—</strong><span>بطاقات أساسية</span></div></article><article><span class="admin-stat-icon" aria-hidden="true"><i class="iconsax" icon-name="location" aria-hidden="true"></i></span><div><strong data-admin-fixed>—</strong><span>مواضع ثابتة</span></div></article><article><span class="admin-stat-icon" aria-hidden="true"><i class="iconsax" icon-name="swap-horizontal" aria-hidden="true"></i></span><div><strong data-admin-movable>—</strong><span>بطاقات متحركة</span></div></article></div>
  <div class="admin-panel"><div class="admin-panel-header"><div><h2>إعدادات البطاقات</h2><p>أنشئ بطاقة تطبيقات، وحدّد الجمهور والإظهار والموضع. احفظ كل بطاقة على حدة.</p></div><button type="button" id="admin-card-create" class="admin-primary" disabled>إضافة بطاقة تطبيقات +</button></div><p id="admin-cards-status" role="status"></p><button type="button" id="admin-cards-retry" hidden>إعادة المحاولة</button><div id="admin-cards"></div></div>
  <aside class="admin-help"><span aria-hidden="true"><i class="iconsax" icon-name="info-circle" aria-hidden="true"></i></span><div><h3>البطاقات والجمهور والصلاحيات</h3><p>بطاقة التطبيقات مشتركة وليست بطاقة شخصية. إظهارها لا يمنح صلاحية للتطبيقات؛ يرى كل موظف التطبيقات المصرح بها فقط. الأدوار تأتي من قاعدة الصلاحيات الحالية.</p><p>الموضع يبدأ من 1. تُحفظ مواضع البطاقات الثابتة، وتُضغط عند غياب بطاقات مقيدة بالأدوار. يحتفظ الموظف بترتيبه للبطاقات المتحركة. قبل إخفاء بطاقة قد يلزم تقديم بطاقة ثابتة تقع خارج العدد الجديد.</p><p>الإخفاء يحتفظ بالإعدادات وترتيب الموظفين. إنشاء البطاقة لا ينشئ ربطًا جديدًا مع الأنظمة؛ البطاقات المتصلة الحالية تحتفظ بمحتواها.</p></div></aside>
</section>
@await Html.PartialAsync("_Events")
@await Html.PartialAsync("_History")
@await Html.PartialAsync("_Images")
@await Html.PartialAsync("_Themes")
@await Html.PartialAsync("_Applications")
@await Html.PartialAsync("_DocumentLibrary")
@await Html.PartialAsync("_SafetyLibrary")
@await Html.PartialAsync("_FixedOrders")
@await Html.PartialAsync("_Media")
@await Html.PartialAsync("_DecisionNotices")
@await Html.PartialAsync("_HeaderContent")
@section Scripts {
  <script src="@Url.Content("~/js/admin-events.js")" asp-append-version="true"></script>
  <script src="@Url.Content("~/js/admin-decision-notices.js")" asp-append-version="true"></script>
  <script src="@Url.Content("~/js/admin-media.js")" asp-append-version="true"></script>
  <script src="@Url.Content("~/js/fixed-order-text.js")" asp-append-version="true"></script>
  <script src="@Url.Content("~/js/admin-fixed-orders.js")" asp-append-version="true"></script>
  <script src="@Url.Content("~/js/admin-documents.js")" asp-append-version="true"></script>
  <script src="@Url.Content("~/js/admin-themes.js")" asp-append-version="true"></script>
  <script src="@Url.Content("~/js/admin-images.js")" asp-append-version="true"></script>
  <script src="@Url.Content("~/js/admin-cards.js")" asp-append-version="true"></script>
  <script src="@Url.Content("~/js/admin-header-content.js")" asp-append-version="true"></script>
  <script src="@Url.Content("~/js/admin-applications.js")" asp-append-version="true"></script>
}
