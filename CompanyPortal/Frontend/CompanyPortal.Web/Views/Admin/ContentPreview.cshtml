@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{ Layout="_Layout";ViewData["BodyClass"]="portal-dashboard admin-draft-preview"; }
@section Metadata {<meta name="companyportal-api-base" content="@(Configuration["Api:BaseUrl"] ?? Url.Content("~/"))">}
@section Head {<link rel="stylesheet" href="@Url.Content("~/vendor/iconsax/icons.css")">}
@section Styles {
  @await Html.PartialAsync("~/Views/Home/_PortalStyles.cshtml")
  <style>.admin-draft-banner{position:sticky;top:0;background:#edf4e8;color:#215c49;padding:12px 22px;z-index:9999;font-size:13px}.admin-draft-preview a,.admin-draft-preview button,.admin-draft-preview input{pointer-events:none}.admin-draft-preview .portal-header{position:relative}.admin-draft-preview .portal-floating-alert,.admin-draft-preview .portal-floating-notice{position:relative;inset:auto;margin:15px;width:280px}.admin-draft-preview .portal-header-search{position:relative;inset:auto;margin:20px;max-width:1000px}.admin-draft-preview .portal-org-status-menu{position:relative;inset:auto;width:min(600px,85vw)}.admin-draft-preview .portal-org-status{position:relative}.admin-draft-preview .portal-org-status-menu>section{padding:18px}.admin-draft-notices{position:fixed;left:18px;top:180px;z-index:9998;display:grid;gap:12px}.admin-draft-media{max-width:1050px;margin:24px auto}.admin-draft-preview .editorial-events-grid{display:block}.admin-draft-preview :is(.editorial-video-card,.editorial-photo-slide){width:min(100%,1000px);min-height:350px;margin:auto}.admin-draft-preview .editorial-photo-slide{height:450px}.admin-draft-media img,.admin-draft-media video{width:100%;max-height:550px;object-fit:contain}.admin-draft-media h3{padding:20px;background:#fff}.admin-draft-preview .portal-policies-sheet{max-height:85vh}</style>
}
<p class="admin-draft-banner" id="draft-message" role="status">جارٍ التحقق من صلاحية المعاينة…</p>
<div id="draft-shell" hidden>
 @await Html.PartialAsync("~/Views/Shared/_PortalHeader.cshtml")
 <main><div class="theme-official-frame" id="theme-official-frame">@await Html.PartialAsync("~/Views/Home/_PersonalWorkspace.cshtml")@await Html.PartialAsync("~/Views/Home/_Workspace.cshtml")</div>
 @await Html.PartialAsync("~/Views/Home/_NewsAndMedia.cshtml")</main>
 @await Html.PartialAsync("~/Views/Home/_Overlays.cshtml")
</div>
@section Scripts {
 <script src="@Url.Content("~/js/theme-appearance.js")" asp-append-version="true"></script>
 <script src="@Url.Content("~/js/fixed-order-text.js")" asp-append-version="true"></script>
 <script src="@Url.Content("~/js/content-preview.js")" asp-append-version="true"></script>
}
