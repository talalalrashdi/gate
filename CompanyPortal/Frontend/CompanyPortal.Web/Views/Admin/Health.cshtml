@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{ Layout=null; }
<!doctype html><html lang="en" dir="ltr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="companyportal-api-base" content="@Configuration["Api:BaseUrl"]"><meta name="frontend-version" content="@(typeof(Program).Assembly.GetName().Version) · @System.IO.File.GetLastWriteTimeUtc(typeof(Program).Assembly.Location).ToString("O")"><title>CompanyPortal · System health</title><base href="@Url.Content("~/")"><link rel="stylesheet" href="@Url.Content("~/css/admin.css")"><link rel="stylesheet" href="@Url.Content("~/css/admin-phase5.css")" asp-append-version="true"></head>
<body class="portal-admin admin-health"><header class="admin-health-top"><a href="@Url.Content("~/admin")"><img src="@Url.Content("~/assets/oman-khanjar.png")" width="38" alt=""> CompanyPortal administration</a><strong>System health</strong></header><main class="admin-health-main"><h1>System health</h1><p>Read-only checks for super admins. No messages, preferences, files or database records are changed.</p><p>Frontend: <span id="health-frontend-version"></span></p><div class="admin-health-actions"><button type="button" id="health-run" class="admin-primary">Run checks</button><button type="button" id="health-copy" disabled>Copy report</button></div><p id="health-status" role="status">Ready.</p><textarea id="health-report" readonly hidden aria-label="Plain-text report"></textarea><div id="health-checks"></div></main><script src="@Url.Content("~/js/admin-health.js")" asp-append-version="true"></script></body></html>
