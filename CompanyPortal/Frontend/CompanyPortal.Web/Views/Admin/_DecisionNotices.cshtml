@foreach(var channel in new[]{1,2}) {
  var key=channel==1?"notices":"alerts";
  var label=channel==1?"التنويهات":"التنبيهات";
  <section data-admin-panel="@key" data-notice-admin="@channel" hidden>
    <div class="admin-panel"><header class="admin-panel-header"><div><h2>إعدادات @label</h2><p>تعرض القرارات المصرح بها للموظف ضمن المدة المحددة، وتبقى ظاهرة بعد القراءة حتى نهايتها.</p></div><button type="button" data-notice-reload>تحديث</button></header>
      <p data-notice-message role="status" aria-live="polite">جارٍ تحميل الإعدادات…</p>
      <form data-notice-settings class="notice-admin-form">
        <fieldset disabled><label><input type="checkbox" name="active"> إظهار @label</label>
          <fieldset><legend>أنواع القرارات</legend><div data-notice-types class="notice-type-options"></div></fieldset>
          <label>مدة العرض من تاريخ النشر بالأيام<input name="days" type="number" min="1" max="365" required></label>
          <div class="notice-presets" aria-label="مدد سريعة">@foreach(var days in new[]{4,7,14,30}){<button type="button" data-notice-days="@days">@days أيام</button>}</div>
          <button class="admin-primary" type="submit">حفظ الإعدادات</button>
        </fieldset>
      </form>
    </div>
    <div class="admin-panel"><header class="admin-panel-header"><div><h2>فترة قرار محدد</h2><p>اختياري: تجاوز المدة العامة أو إخفاء القرار من هذا القسم فقط. جميع الأوقات بتوقيت عُمان.</p></div></header>
      <form data-notice-window class="notice-admin-form"><fieldset disabled>
        <label>القرار<select name="decision" required><option value="">اختر قرارًا</option></select></label>
        <p data-notice-preview></p>
        <label>من<input type="datetime-local" name="from" step="1"></label><label>إلى<input type="datetime-local" name="to" step="1"></label>
        <label><input type="checkbox" name="hidden"> إخفاؤه من هذا القسم</label>
        <div class="notice-presets">@foreach(var days in new[]{4,7,14,30}){<button type="button" data-window-days="@days">@days أيام</button>}</div>
        <button type="submit" class="admin-primary">حفظ فترة القرار</button><button type="button" data-notice-reset>استعادة المدة العامة</button>
      </fieldset></form>
    </div>
  @if(channel==1){
    <div class="admin-panel" id="custom-popup-admin"><header class="admin-panel-header"><div><h2>تنويهات مخصصة</h2><p>اكتب النوع والتفاصيل دون إنشاء قرار. تظهر للجميع خلال الفترة؛ إغلاق الموظف يحفظ إخفاءها عنه.</p></div></header>
    <p id="custom-popup-status" role="status"></p>
    <form id="custom-popup-form" class="notice-admin-form"><fieldset disabled>
      <input type="hidden" name="popupId"><label>النوع<input name="popupType" maxlength="100" required></label>
      <label>التفاصيل<textarea name="details" maxlength="2000" rows="4" required></textarea></label>
      <label>بداية العرض<input name="startAt" type="datetime-local" required></label><label>نهاية العرض<input name="endAt" type="datetime-local" required></label>
      <label><input name="isDisplayed" type="checkbox"> إظهار للجميع خلال الفترة المحددة</label>
      <div><button type="submit" class="admin-primary">حفظ التنويه</button><button type="button" id="custom-popup-cancel">إلغاء / تنويه جديد</button></div>
    </fieldset></form><div id="custom-popup-list"></div><button type="button" id="custom-popup-retry" hidden>إعادة المحاولة</button></div>
  }
  </section>
}
