@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    ViewData["BodyClass"] = "portal-dashboard";
}
@section Metadata {
  <meta name="theme-color" content="#f5f1ea">
  <meta name="companyportal-api-base" content="@(Configuration["Api:BaseUrl"] ?? Url.Content("~/"))">
}
@section Head {
  <link rel="preload" href="@Url.Content("~/assets/fonts/GTAmericaArabic-Regular.ttf")" as="font" type="font/ttf" crossorigin>
  <link rel="stylesheet" href="@Url.Content("~/vendor/iconsax/icons.css")">
}
@section Styles {
  <link rel="stylesheet" href="@Url.Content("~/css/workspace.css")">
  <link rel="stylesheet" href="@Url.Content("~/css/editorial.css")">
  <link rel="stylesheet" href="@Url.Content("~/css/section-navigation.css")">
  <link rel="stylesheet" href="@Url.Content("~/css/systems-catalog.css")">
  <link rel="stylesheet" href="@Url.Content("~/css/notice-strip.css")">
  <link rel="stylesheet" href="@Url.Content("~/css/themes.css")">
  <link rel="stylesheet" href="@Url.Content("~/css/palette.css")">
  <link rel="stylesheet" href="@Url.Content("~/css/planner.css")">
  <link rel="stylesheet" href="@Url.Content("~/css/layout.css")">
  <link rel="stylesheet" href="@Url.Content("~/css/personal-workspace.css")">
  <link rel="stylesheet" href="@Url.Content("~/css/documents-dialog.css")">
  <link rel="stylesheet" href="@Url.Content("~/css/theme-work.css")">
  <link rel="stylesheet" href="@Url.Content("~/css/theme-official.css")">
  <link rel="stylesheet" href="@Url.Content("~/css/library.css")">
  <link rel="stylesheet" href="@Url.Content("~/css/theme-national-day.css")">
  <link rel="stylesheet" href="@Url.Content("~/css/floating-calendar.css")">
  <link rel="stylesheet" href="@Url.Content("~/css/header-scroll.css")">
}

@await Html.PartialAsync("_PortalHeader")
<main>
  <div class="theme-official-frame" id="theme-official-frame">
    @await Html.PartialAsync("_PersonalWorkspace")
    @await Html.PartialAsync("_Workspace")
  </div>
  @await Html.PartialAsync("_NewsAndMedia")
  @await Html.PartialAsync("_Safety")
  @await Html.PartialAsync("_SystemsCatalog")
  @await Html.PartialAsync("_Documents")
</main>
@await Html.PartialAsync("_PortalFooter")
@await Html.PartialAsync("_Overlays")

@section Scripts {
  @await Html.PartialAsync("_PortalScripts")
}
