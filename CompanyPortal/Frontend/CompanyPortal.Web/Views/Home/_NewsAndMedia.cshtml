<section class="portal-section portal-media portal-editorial editorial-light" id="media" aria-labelledby="media-title">
      <div class="editorial-inner">
        <header class="editorial-masthead"><div><h2 id="media-title"><i class="iconsax editorial-heading-icon" icon-name="video-horizontal" aria-hidden="true"></i>أخبار عامة<span class="editorial-title-dot">.</span></h2></div><div class="editorial-edition editorial-current-date" id="editorial-current-date"><strong></strong><small></small></div></header>

        <section class="editorial-block editorial-news-refresh" id="editorial-news" aria-labelledby="media-title">
          <div class="editorial-news-board editorial-news-panel" id="editorial-agency-news"></div>
        </section>

        <section class="editorial-block" id="editorial-events" aria-labelledby="editorial-events-title">
          <div class="editorial-block-heading"><h3 id="editorial-events-title"><i class="iconsax editorial-heading-icon" icon-name="calendar-2" aria-hidden="true"></i>أخبارنا</h3><div class="editorial-video-toolbar"><div class="editorial-video-controls portal-arrow-controls"><button type="button" class="portal-arrow-button" data-video-prev aria-label="الفيديو السابق" aria-controls="editorial-video-track" disabled><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="m9 5 7 7-7 7"/></svg></button><output data-video-status aria-live="polite">0 / 0</output><button type="button" class="portal-arrow-button" data-video-next disabled aria-label="الفيديو التالي" aria-controls="editorial-video-track"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="m15 5-7 7 7 7"/></svg></button></div></div></div>
          <p id="portal-media-status" role="status">جارٍ تحميل الصور والفيديوهات…</p><button type="button" id="portal-media-retry" hidden>إعادة المحاولة</button>
          <div class="editorial-events-grid editorial-events-rows">
            <div class="editorial-video-carousel" role="region" aria-label="فيديوهات أخبارنا" aria-roledescription="عارض فيديوهات"><button type="button" class="editorial-video-edge editorial-video-edge-right" data-video-prev disabled aria-label="الفيديو السابق عند الحافة اليمنى" aria-controls="editorial-video-track"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m9 5 7 7-7 7"/></svg></button><div class="editorial-video-viewport editorial-media-viewport"><div class="editorial-video-track" id="editorial-video-track" tabindex="0" aria-label="فيديوهات أخبارنا، استخدم سهمي اليمين واليسار للتنقل"></div></div><button type="button" class="editorial-video-edge editorial-video-edge-left" data-video-next disabled aria-label="الفيديو التالي عند الحافة اليسرى" aria-controls="editorial-video-track"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m15 5-7 7 7 7"/></svg></button><p id="portal-videos-empty" hidden>لا توجد فيديوهات متاحة حاليًا.</p></div>
            <div class="editorial-photo-collection"><div class="editorial-photo-slider editorial-media-viewport" tabindex="0" aria-label="صور وألبومات أخبارنا، استخدم الأسهم للتنقل"></div><div class="editorial-photo-controls"><button type="button" class="portal-arrow-button" data-photo-prev aria-label="المجموعة السابقة" disabled>→</button><output data-photo-status aria-live="polite">0 / 0</output><button type="button" class="portal-arrow-button" data-photo-next aria-label="المجموعة التالية" disabled>←</button></div><p id="portal-photos-empty" hidden>لا توجد صور متاحة حاليًا.</p></div>
          </div>
        </section>
      </div>
    </section>

        <section class="portal-section editorial-magazine" id="editorial-magazine" aria-labelledby="editorial-magazine-title">
          <div class="editorial-monthly-heading">
            <h3 id="editorial-magazine-title">مجلة الشهر<span data-mag-name>—</span></h3>
            @* TEST link for now: replace href with the real نشرة الفلق address. *@
            <a class="editorial-bulletin-link" href="https://example.com/" target="_blank" rel="noopener noreferrer">الانتقال الى نشرة الفلق <span aria-hidden="true">←</span></a>
            <label class="editorial-magazine-issue-select"><select data-mag-issue aria-label="اختيار عدد المجلة"><option value="">جارٍ تحميل الأعداد…</option></select></label>
          </div>
          <div class="editorial-local-reader" id="monthly-reader" aria-label="قارئ مجلة الشهر">
            <button type="button" data-mag-retry hidden>إعادة تحميل المجلة</button>
            <div class="editorial-local-thumbnails" id="monthly-thumbnails" aria-label="اختيار صفحة" hidden></div>
            <div class="editorial-magazine-book">
              <button class="editorial-magazine-page-arrow" type="button" data-mag-prev aria-label="الصفحات السابقة" disabled>→</button>
              <div class="editorial-local-stage" tabindex="0" aria-label="صفحات المجلة؛ استخدم سهمي اليمين واليسار للتقليب"><div class="editorial-local-spread"></div><p class="editorial-local-message" role="status">جارٍ تجهيز المجلة…</p></div>
              <button class="editorial-magazine-page-arrow" type="button" data-mag-next aria-label="الصفحات التالية" disabled>←</button>
            </div>
            <div class="editorial-magazine-toolbar" role="group" aria-label="متحكمات عرض المجلة">
              <div class="editorial-magazine-view-controls" role="group" aria-label="أدوات عرض المجلة">
                <label class="editorial-magazine-page-input">الصفحة <input data-mag-page type="number" min="1" value="1" inputmode="numeric" aria-label="الانتقال إلى صفحة" disabled></label>
                <a class="editorial-magazine-pdf" data-mag-pdf aria-disabled="true" target="_blank" rel="noopener" aria-label="فتح المجلة بصيغة PDF" title="فتح PDF"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9Z"/><path d="M14 3v6h6M8 14h8M8 17h5"/></svg></a>
                <button type="button" data-mag-fullscreen aria-label="ملء الشاشة" title="التوسيع"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 3H3v5m13-5h5v5M3 16v5h5m13-5v5h-5"/></svg></button>
                <button type="button" data-mag-zoom aria-pressed="false" aria-label="تكبير الصفحات" title="التكبير"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5M7.5 10.5h6m-3-3v6"/></svg></button>
                <button type="button" data-mag-zoom-out aria-label="تصغير الصفحات" title="التصغير" disabled><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5M7.5 10.5h6"/></svg></button>
                <button type="button" data-mag-thumbnails aria-expanded="false" aria-controls="monthly-thumbnails" aria-label="العرض الشبكي للصفحات" title="العرض الشبكي"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg></button>
              </div>
            </div>
          </div>
        </section>
