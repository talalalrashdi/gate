<details id="portal-simulation" class="portal-simulation">
  <summary aria-label="وضع المحاكاة" title="وضع المحاكاة"><svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M9 3h6M10 3v7L5 19a1 1 0 0 0 1 2h12a1 1 0 0 0 1-2l-5-9V3M8 15h8"/></svg></summary>
  <section aria-label="اختبارات البوابة" popover="manual"><header><strong>محاكاة أحداث البوابة</strong><small>بيانات مؤقتة في هذه الصفحة فقط — دون حفظ في قاعدة البيانات.</small></header>
    <fieldset class="simulation-group"><legend>القرارات والتنويهات والتنبيهات</legend><div class="simulation-actions"><button type="button" data-simulate="decision">قرار جديد</button><button type="button" data-simulate="notice">قرار تنويه جديد</button><button type="button" data-simulate="alert">قرار إعلان / تنبيه جديد</button><button type="button" data-simulation-rules>تحديث إعدادات الأنواع</button></div></fieldset>
    <fieldset class="simulation-group"><legend>الأخبار</legend><div class="simulation-actions"><button type="button" data-simulate="news">خبر جديد</button><button type="button" data-simulate="breaking">خبر عاجل</button></div></fieldset>
    <fieldset class="simulation-group"><legend>المراسلات</legend><div class="simulation-actions"><button type="button" data-simulate="correspondence">مراسلة جديدة</button></div></fieldset>
    <fieldset class="simulation-group"><legend>دليل الهاتف</legend><div class="simulation-actions"><button type="button" data-simulate="phone">دليل الهاتف — حالات متنوعة</button></div></fieldset>
    <fieldset class="simulation-group"><legend>Outlook</legend><div class="simulation-actions"><button type="button" data-outlook-simulate="outlook-start">عرض البريد والجدول والمهام</button></div></fieldset>
    <fieldset class="simulation-group"><legend>البريد الإلكتروني</legend><div class="simulation-actions"><button type="button" data-outlook-simulate="mail-new">رسالة جديدة</button><button type="button" data-outlook-simulate="mail-read">قراءة رسالة</button><button type="button" data-outlook-simulate="mail-delete">حذف رسالة</button><button type="button" data-outlook-simulate="mail-empty">بريد فارغ</button></div></fieldset>
    <fieldset class="simulation-group"><legend>التقويم</legend><div class="simulation-actions"><button type="button" data-outlook-simulate="calendar-new">موعد جديد اليوم</button><button type="button" data-outlook-simulate="calendar-update">تعديل موعد</button><button type="button" data-outlook-simulate="calendar-cancel">إلغاء موعد</button><button type="button" data-outlook-simulate="calendar-all-day">موعد طوال اليوم</button><button type="button" data-outlook-simulate="calendar-empty">تقويم فارغ</button><button type="button" data-outlook-simulate="calendar-shared">تقويم مشترك</button><button type="button" data-outlook-simulate="calendar-shared-manual">مشترك بتحديث يدوي</button><button type="button" data-outlook-simulate="calendar-revoke">سحب صلاحية المشترك</button></div></fieldset>
    <fieldset class="simulation-group"><legend>المهام</legend><div class="simulation-actions"><button type="button" data-outlook-simulate="task-new">مهمة جديدة</button><button type="button" data-outlook-simulate="task-complete">اكتمال مهمة</button><button type="button" data-outlook-simulate="task-examples">مهام بحالات متنوعة</button><button type="button" data-outlook-simulate="task-empty">لا توجد مهام</button></div></fieldset>
    <fieldset class="simulation-group"><legend>اتصال Outlook</legend><div class="simulation-actions"><button type="button" data-outlook-simulate="outlook-disconnect">قطع الاتصال</button><button type="button" data-outlook-simulate="outlook-reconnect">إعادة الاتصال</button><button type="button" data-outlook-simulate="outlook-exit">إنهاء محاكاة Outlook</button></div></fieldset>
    <fieldset class="simulation-org-status"><legend>حالة المؤسسة</legend><div><button type="button" data-simulate-status="green" aria-pressed="false">أخضر</button><button type="button" data-simulate-status="yellow" aria-pressed="false">أصفر</button><button type="button" data-simulate-status="orange" aria-pressed="false">برتقالي</button><button type="button" data-simulate-status="red" aria-pressed="false">أحمر</button></div><button type="button" data-simulate-status="real">العودة للحالة الحقيقية</button></fieldset>
    <button type="button" data-simulate="reset">مسح المحاكاة</button><p data-simulation-status role="status" aria-live="polite">اختر حدثًا لتجربة ظهوره في البوابة.</p>
  </section>
</details>
<dialog id="portal-simulation-dialog" aria-labelledby="simulation-dialog-title"><header><strong>معاينة محاكاة</strong><button type="button" data-simulation-dialog-close aria-label="إغلاق معاينة المحاكاة">×</button></header><h2 id="simulation-dialog-title"></h2><p></p></dialog>
