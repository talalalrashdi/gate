@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="companyportal-api-base" content="@(Configuration["Api:BaseUrl"] ?? Url.Content("~/"))">
  <title>إدارة البوابة</title>
  <base href="@Url.Content("~/")">
  <link rel="icon" type="image/png" href="@Url.Content("~/assets/oman-khanjar.png")">
  <link rel="stylesheet" href="@Url.Content("~/css/admin.css")" asp-append-version="true">
  @await RenderSectionAsync("Styles", required: false)
</head>
<body class="portal-admin" data-admin-start="@(ViewData["AdminSection"] ?? "overview")">
  <div class="admin-shell">
    <aside class="admin-sidebar">
      <a class="admin-brand" href="@Url.Content("~/admin")">
        <img src="@Url.Content("~/assets/oman-khanjar.png")" alt="" width="44" height="48">
        <span><strong>البوابة</strong><small>مساحة الإدارة</small></span>
      </a>
      <div class="admin-nav-label">إدارة البوابة</div>
      <nav class="admin-nav" aria-label="أقسام الإدارة">
        <button type="button" data-admin-section="overview" disabled><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="2"/><rect x="14" y="3" width="7" height="7" rx="2"/><rect x="3" y="14" width="7" height="7" rx="2"/><rect x="14" y="14" width="7" height="7" rx="2"/></svg><span>نظرة عامة</span></button>
        <button type="button" data-admin-section="cards" disabled><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="7" rx="2"/><rect x="3" y="14" width="8" height="6" rx="2"/><rect x="14" y="14" width="7" height="6" rx="2"/></svg><span>البطاقات الأساسية</span></button>
        <button type="button" data-admin-section="applications" disabled><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="2"/><rect x="14" y="3" width="7" height="7" rx="2"/><rect x="3" y="14" width="7" height="7" rx="2"/><rect x="14" y="14" width="7" height="7" rx="2"/></svg><span>الأنظمة الإلكترونية</span></button>
        <button type="button" data-admin-section="documents" disabled><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 3h10l4 4v14H5Z M14 3v5h5 M8 12h8 M8 16h8"/></svg><span>وثائق تهمك</span></button>
        <button type="button" data-admin-section="safety" disabled><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 3 7v5c0 5 9 9 9 9s9-4 9-9V7Z M8 12l3 3 5-6"/></svg><span>تعليمات السلامة</span></button>
        <button type="button" data-admin-section="fixed-orders" disabled><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 3h14v18H5Z M8 8h8 M8 12h8 M8 16h5"/></svg><span>التوجيهات السامية</span></button>
        <button type="button" data-admin-section="header-content" disabled><span aria-hidden="true">☎</span><span>أرقام تهمك والحالة</span></button>
        <button type="button" data-admin-section="notices" disabled><span aria-hidden="true">ⓘ</span><span>التنويهات</span></button>
        <button type="button" data-admin-section="alerts" disabled><span aria-hidden="true">♧</span><span>التنبيهات</span></button>
        <button type="button" data-admin-section="media" disabled><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="m10 8 6 4-6 4Z"/></svg><span>أخبارنا</span></button>
        <button type="button" data-admin-section="images" disabled><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="8" cy="8" r="1.5"/><path d="m3 17 5-5 4 4 4-6 5 7"/></svg><span>صور الواجهة</span></button>
        <button type="button" data-admin-section="themes" disabled><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a9 9 0 1 0 0 18h1a2 2 0 0 0 1-3.7 1.7 1.7 0 0 1 1-3.1h2A4 4 0 0 0 21 10c0-4-4-7-9-7Z"/><path d="M7 10h.01M10 6.5h.01M15 7h.01M6.5 14.5h.01"/></svg><span>الثيمات والمظهر</span></button>
      </nav>
      <div class="admin-sidebar-bottom"><span class="admin-sidebar-note">إعدادات مشتركة<br>لتجربة موحّدة في البوابة</span><a href="@Url.Content("~/")"><span aria-hidden="true">↗</span> العودة إلى البوابة</a></div>
    </aside>
    <main class="admin-main" id="admin-main">
      <header class="admin-topbar"><div>البوابة <span aria-hidden="true">/</span> لوحة الإدارة</div><a href="@Url.Content("~/")">عرض البوابة <span aria-hidden="true">↗</span></a></header>
      @if (Configuration.GetValue<bool>("Diagnostics:Enabled")) { <a style="margin:12px 32px;display:inline-block" href="@Url.Content("~/admin/diagnostics")">فحص الاتصال — أداة مؤقتة للإعداد</a> }
      <div class="admin-content">
        <div class="admin-page-heading"><div><p class="admin-eyebrow">لوحة الإدارة</p><h1 id="admin-page-title">@(ViewData["AdminSection"] as string == "cards" ? "إدارة البطاقات الأساسية" : "نظرة عامة")</h1><p id="admin-page-description">إدارة محتوى البوابة ومظهرها من مكان واحد.</p></div><span class="admin-context"><span aria-hidden="true"></span> إعدادات البوابة</span></div>
        <div class="admin-status-bar"><span class="admin-status-dot" aria-hidden="true"></span><p id="admin-status" role="status" aria-live="polite">جارٍ التحقق من الصلاحية…</p><button type="button" id="admin-retry" hidden>إعادة المحاولة</button></div>
        <div id="admin-access-message" class="admin-access-message"><span aria-hidden="true">◇</span><h2>مساحة إدارة البوابة</h2><p>يجري التحقق من صلاحية حسابك لعرض إعدادات الإدارة.</p></div>
        <div id="admin-workspace" hidden>@RenderBody()</div>
        <footer class="admin-footer"><span>البوابة · مساحة الإدارة</span><span>تظهر التغييرات للمستخدمين عند إعادة تحميل البوابة.</span></footer>
      </div>
    </main>
  </div>
  <script src="@Url.Content("~/js/admin-navigation.js")" asp-append-version="true"></script>
  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
