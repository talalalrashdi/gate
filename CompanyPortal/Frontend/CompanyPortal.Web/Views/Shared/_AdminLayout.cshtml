@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="companyportal-api-base" content="@(Configuration["Api:BaseUrl"] ?? Url.Content("~/"))">
  <title>إدارة البوابة</title>
  <base href="@Url.Content("~/")">
  <link rel="icon" type="image/png" href="@Url.Content("~/assets/oman-khanjar.png")">
  <link rel="stylesheet" href="@Url.Content("~/vendor/iconsax/icons.css")">
  <link rel="stylesheet" href="@Url.Content("~/css/admin.css")" asp-append-version="true">
  <link rel="stylesheet" href="@Url.Content("~/css/admin-core.css")" asp-append-version="true">
  <link rel="stylesheet" href="@Url.Content("~/css/admin-phase5.css")" asp-append-version="true">
  @await RenderSectionAsync("Styles", required: false)
</head>
<body class="portal-admin" data-admin-start="@(ViewData["AdminSection"] ?? "overview")">
  <div class="admin-shell">
    <aside class="admin-sidebar">
      <a class="admin-brand" href="@Url.Content("~/admin")">
        <img src="@Url.Content("~/assets/oman-khanjar.png")" alt="" width="44" height="48">
        <span><strong>البوابة</strong><small>مساحة الإدارة</small></span>
      </a>
      <div class="admin-nav-label">إدارة البوابة</div>
      <nav class="admin-nav" aria-label="أقسام الإدارة">
<div class="admin-nav-group" data-admin-group hidden><h2>المحتوى</h2><button type="button" data-admin-section="events" disabled><i class="iconsax" icon-name="calendar-1" aria-hidden="true"></i><span>الفعاليات</span></button><button type="button" data-admin-section="media" disabled><i class="iconsax" icon-name="video-horizontal" aria-hidden="true"></i><span>أخبارنا</span></button><button type="button" data-admin-section="fixed-orders" disabled><i class="iconsax" icon-name="document-text-1" aria-hidden="true"></i><span>التوجيهات السامية</span></button><button type="button" data-admin-section="notices" disabled><i class="iconsax" icon-name="info-circle" aria-hidden="true"></i><span>التنويهات</span></button><button type="button" data-admin-section="alerts" disabled><i class="iconsax" icon-name="bell-1" aria-hidden="true"></i><span>التنبيهات</span></button></div>
<div class="admin-nav-group" data-admin-group hidden><h2>المكتبات</h2><button type="button" data-admin-section="documents" disabled><i class="iconsax" icon-name="folder-2" aria-hidden="true"></i><span>وثائق تهمك</span></button><button type="button" data-admin-section="safety" disabled><i class="iconsax" icon-name="shield-tick" aria-hidden="true"></i><span>تعليمات السلامة</span></button></div>
<div class="admin-nav-group" data-admin-group hidden><h2>الواجهة</h2><button type="button" data-admin-section="cards" disabled><i class="iconsax" icon-name="grid-apps" aria-hidden="true"></i><span>البطاقات الأساسية</span></button><button type="button" data-admin-section="images" disabled><i class="iconsax" icon-name="picture-1" aria-hidden="true"></i><span>صور الواجهة</span></button><button type="button" data-admin-section="themes" disabled><i class="iconsax" icon-name="brush-1" aria-hidden="true"></i><span>الثيمات والمظهر</span></button></div>
<div class="admin-nav-group" data-admin-group hidden><h2>الإعدادات</h2><button type="button" data-admin-section="header-content" disabled><i class="iconsax" icon-name="phone" aria-hidden="true"></i><span>أرقام تهمك والحالة</span></button><button type="button" data-admin-section="applications" disabled><i class="iconsax" icon-name="setting-2" aria-hidden="true"></i><span>الأنظمة الإلكترونية</span></button></div><div class="admin-nav-group" data-admin-super hidden><h2>الإدارة</h2><button type="button" data-admin-section="history" disabled><i class="iconsax" icon-name="history" aria-hidden="true"></i><span>سجل التعديلات</span></button><a class="admin-health-nav" href="@Url.Content("~/admin/health")"><i class="iconsax" icon-name="activity-chart" aria-hidden="true"></i><span>System health</span></a></div></nav>
      <div class="admin-sidebar-bottom"><a href="@Url.Content("~/")"><i class="iconsax" icon-name="logout-1" aria-hidden="true"></i> العودة إلى البوابة</a></div>
    </aside>
    <main class="admin-main" id="admin-main">
      <header class="admin-topbar"><div>البوابة <span aria-hidden="true">/</span> لوحة الإدارة</div><a href="@Url.Content("~/")">عرض البوابة <i class="iconsax" icon-name="logout-1" aria-hidden="true"></i></a></header>
      <div class="admin-content">
        <div class="admin-page-heading"><div><p class="admin-eyebrow">لوحة الإدارة</p><h1 id="admin-page-title">@(ViewData["AdminSection"] as string == "cards" ? "إدارة البطاقات الأساسية" : "نظرة عامة")</h1><p id="admin-page-description">إدارة محتوى البوابة ومظهرها من مكان واحد.</p></div><span class="admin-context"><span aria-hidden="true"></span> إعدادات البوابة</span></div>
        <div class="admin-status-bar"><span class="admin-status-dot" aria-hidden="true"></span><p id="admin-status" role="status" aria-live="polite">جارٍ التحقق من الصلاحية…</p><button type="button" id="admin-retry" hidden>إعادة المحاولة</button></div>
        <div id="admin-access-message" class="admin-access-message"><i class="iconsax" icon-name="shield-tick" aria-hidden="true"></i><h2>مساحة إدارة البوابة</h2><p>يجري التحقق من صلاحية حسابك لعرض إعدادات الإدارة.</p></div>
        <div id="admin-workspace" hidden>@RenderBody()</div>
        <footer class="admin-footer"><span>البوابة · مساحة الإدارة</span><span>تُحفظ إعدادات كل قسم على حدة؛ راجع رسالة الحفظ قبل المغادرة.</span></footer>
      </div>
    </main>
  </div>
  <dialog id="admin-confirm" class="admin-confirm" aria-labelledby="admin-confirm-title" aria-describedby="admin-confirm-message"><h2 id="admin-confirm-title"></h2><p id="admin-confirm-message"></p><div class="admin-confirm-actions"><button type="button" data-confirm-no>إلغاء</button><button type="button" data-confirm-yes>متابعة</button></div></dialog>
  <dialog id="admin-content-preview" class="admin-content-preview" aria-label="معاينة قبل الحفظ"><header><strong>معاينة القيم غير المحفوظة</strong><button type="button">إغلاق المعاينة</button></header><iframe title="معاينة محتوى البوابة قبل الحفظ" src="about:blank"></iframe></dialog>
  <div id="admin-toasts" class="admin-toasts" aria-label="رسائل الإدارة"></div>
  <script src="@Url.Content("~/js/admin-core.js")" asp-append-version="true"></script>
  <script src="@Url.Content("~/js/admin-navigation.js")" asp-append-version="true"></script>
  <script src="@Url.Content("~/js/admin-changes.js")" asp-append-version="true"></script>
  <script src="@Url.Content("~/js/admin-overview.js")" asp-append-version="true"></script>
  <script src="@Url.Content("~/js/admin-history-diff.js")" asp-append-version="true"></script>
  <script src="@Url.Content("~/js/admin-history.js")" asp-append-version="true"></script>
  <script src="@Url.Content("~/js/admin-content-preview.js")" asp-append-version="true"></script>
  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
