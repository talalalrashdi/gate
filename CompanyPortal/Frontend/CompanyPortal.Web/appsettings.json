{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Diagnostics": {
    "SimulationEnabled": false
  },
  "CentralLogging": {
    "Enabled": true,
    "SystemId": 9999,
    "FallbackDirectory": "App_Data/Logs"
  },
  "ConnectionStrings": {
    "CentralLog": "Server=localhost;Database=CentralLog;Integrated Security=True;Encrypt=True;TrustServerCertificate=True;Connect Timeout=3;"
  }
}
